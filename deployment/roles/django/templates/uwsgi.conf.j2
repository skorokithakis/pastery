description "uSGI instance."
author      "Stavros Korokithakis"

start on runlevel [2345]
stop on runlevel [!2345]
respawn
respawn limit 10 30

env ENVIRONMENT="{{ env_root }}"
env PROJECT="{{ project_root }}"

setuid {{ project_name }}
exec {{ env_root }}/bin/uwsgi --chdir={{ project_root }} --ini={{ project_root }}/uwsgi.ini
