description "Captain Webhook instance."
author      "Stavros Korokithakis"

start on runlevel [2345]
stop on runlevel [!2345]
respawn
respawn limit 10 30

env ENVIRONMENT="{{ env_root }}"
env PROJECT="{{ project_root }}"

exec {{ env_root }}/bin/cptwebhook -i 127.0.0.1 -p {{ cptwebhook_port }} -k {{ webhook_key }} "{{ env_root }}/bin/ansible-pull -o -C {{ branch }} -d {{ project_root }} -U {{ repo }}"
